# Paper mode only. Live mode is refused by config.from_env.
TPB_MODE=paper

# instant | colocated | vps_nearby | home_broadband | home_wifi_poor
# Measured REST round trip from this machine was ~775ms median, so
# home_broadband is OPTIMISTIC here until a WebSocket transport exists.
TPB_LATENCY_PROFILE=home_broadband

# Seeded so two paper runs are comparable across strategy changes.
TPB_LATENCY_SEED=7

TPB_STARTING_BALANCE=1000
TPB_LOG_LEVEL=INFO

# ---------------------------------------------------------------- real money
# Only read with `python -m troll_poly_bot --live`. Keep this file out of git
# (.env is ignored). --live alone is a DRY RUN; add --armed to post orders.
#
# The private key that SIGNS. Email login: Polymarket profile -> settings -> export private key
# (Magic's reveal page). Its address is the signer, NOT the address on your profile. That is normal.
# TPB_POLY_PRIVATE_KEY=0x...
# The account wallet that HOLDS the funds: the address shown under your Polymarket profile.
# (The older name TPB_POLY_FUNDER still works.) Unset, the SDK derives the signer's Deposit Wallet.
# TPB_POLY_WALLET=0x...
# Optional: lets the bot redeem winners itself. Polymarket app -> Settings -> API Keys -> Relayer
# API Keys; copy the key AND the signer address it shows. Without it, use Auto-Redeem in the app.
# TPB_POLY_RELAYER_API_KEY=
# TPB_POLY_RELAYER_API_KEY_ADDRESS=0x...
# Not needed any more: the venue reports the wallet type (Deposit Wallet, legacy proxy, Safe, plain).
# `python scripts/live_check.py` shows what it sees.
# TPB_POLY_SIGNATURE_TYPE=
# Optional; derived from the key on first run if absent.
# TPB_POLY_API_KEY=
# TPB_POLY_API_SECRET=
# TPB_POLY_API_PASSPHRASE=
# Required to --armed. Spell it out: you are acknowledging real orders.
# TPB_LIVE_ACK=I_UNDERSTAND_REAL_MONEY

# ----------------------------------------------------------- dashboard login
# REQUIRED to start `python -m troll_poly_bot.web`. The console is not
# read-only -- its API starts and stops the trader, rewrites data/controls.json
# and creates the kill file -- so it refuses to serve without an admin identity.
# One admin, no registration, no user database.
TPB_ADMIN_EMAIL=you@example.com
TPB_ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Better: store a hash instead and drop the line above. It wins when both are
# set. Generate with `python scripts/hash_password.py`.
# TPB_ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$...$...
# Set to 1 only when a TLS-terminating proxy is in front, so the session cookie
# is never sent over a plaintext hop. On plain HTTP this must stay unset or the
# browser silently drops the cookie and the login never takes.
# TPB_ADMIN_COOKIE_SECURE=1

# Paper execution scenario: optimistic | realistic (default) | conservative | stress | venue_lag
# (venue_lag: match against the local book 500 ms after arrival, no quote-survival rule)
# TPB_EXECUTION_SCENARIO=realistic
# --mode live is refused until the graduation criteria pass (graduation.py). Override only on purpose:
# TPB_GRADUATION_OVERRIDE=I_ACCEPT_UNPROVEN_EDGE

# ------------------------------------------------------ MOMENTUM_TAKER (strategy/momentum.py)
# Selected with --strategy momentum_taker (or TPB_STRATEGY=momentum_taker).
# strict (default) or easy. easy is DATA COLLECTION ONLY: the archive measured
# its net at about -1.6 c/share; it is never the default.
# TPB_MOMENTUM_PROFILE=strict
# Any MomentumConfig field can be overridden as TPB_MOMENTUM_<FIELD>. The ones that matter most:
# TPB_MOMENTUM_Z_THRESHOLD=3.0          # 5 s move in sigma units to count as STRONG
# TPB_MOMENTUM_MIN_NET_EDGE=0.02        # per share, after entry fee, exit fee+spread, slippage, latency, uncertainty
# TPB_MOMENTUM_MAX_QUOTE_AGE_MS=500     # the traded token's quote age; NOT auto-widened
# TPB_MOMENTUM_MAX_SPOT_AGE_MS=1000
# TPB_MOMENTUM_MAX_SPREAD=0.03
# TPB_MOMENTUM_MAX_SLIPPAGE=0.02        # price cap above the ask; the cap is also <= the max entry price
# TPB_MOMENTUM_INCLUDE_EXIT_COSTS=1     # a pre-settlement exit pays a taker fee and the spread
# TPB_MOMENTUM_UNCERTAINTY_BASE=0.003
# TPB_MOMENTUM_UNCERTAINTY_FRAC=0.5
# TPB_MOMENTUM_ASSET_UNCERTAINTY=XRP:0.01,DOGE:0.01
# TPB_MOMENTUM_ASSETS=BTC,ETH           # allow-list; empty = every listed asset
# TPB_MOMENTUM_MIN_TIME_REMAINING_S=90
# TPB_MOMENTUM_TAKE_PROFIT=0.04
# TPB_MOMENTUM_STOP_LOSS=0.06
# TPB_MOMENTUM_MAX_HOLD_S=45
# TPB_MOMENTUM_EXPECTED_CONTINUATION_S=20
# TPB_MOMENTUM_CALIBRATION_PATH=data/momentum_calibration.json   # fitted on a TRAINING period only

# ------------------------------------------------------------- SPOT_LAG (strategy/spot_lag.py)
# Selected with --strategy spot_lag. EXPERIMENTAL and doubly gated: the engine
# refuses to start without TPB_SPOT_LAG_ENABLED=1, and refuses --mode micro-live
# or live unless TPB_SPOT_LAG_ALLOW_REAL=1 as well. Evidence and caveats:
# docs/spot_lag_study_2026-09-23.md. Stages: ecosystem.spotlag.config.js.
# TPB_SPOT_LAG_ENABLED=0
# TPB_SPOT_LAG_ALLOW_REAL=0
# Any SpotLagConfig field can be overridden as TPB_SPOT_LAG_<FIELD>:
# TPB_SPOT_LAG_K_SIGMA=3.0              # 1 s spot move in sigma units: the shock
# TPB_SPOT_LAG_MIN_NET_EDGE=0.02        # after both fees, exit half spread, 0.5c slippage, 0.5c uncertainty
# TPB_SPOT_LAG_MAX_SLIPPAGE=0.02        # FOK cap above the ask; never above the max entry price
# TPB_SPOT_LAG_HOLD_S=5                 # sell this long after the fill ...
# TPB_SPOT_LAG_EXTEND_Z1=0.5            # ... unless the last second's spot move is still >= this many sigma our way
# TPB_SPOT_LAG_EXTEND_MAX_HOLD_S=10     # ... and never later than this (<= HOLD_S turns the extension off)
# TPB_SPOT_LAG_MAX_QUOTE_AGE_MS=250     # venue-timestamped quote age of the traded token
# TPB_SPOT_LAG_SIZE_SHARES=5
# TPB_SPOT_LAG_EXCLUDE_ASSETS=HYPE      # lost in training and out of sample; empty = none
# TPB_SPOT_LAG_ASSETS=                  # allow-list; empty = every listed asset
# Multi-market budget: every 5-minute market (asset x window) is its own opportunity;
# these limits are GLOBAL across all of them. The bot applies the tighter of these
# and its own risk limits; in micro-live the TPB_MICRO_* ceilings bound them too.
# TPB_SPOT_LAG_MAX_SIMULTANEOUS_POSITIONS=4   # open positions + working entries
# TPB_SPOT_LAG_MAX_BUYS_PER_HOUR=60           # BUY orders sent, killed ones included
# TPB_SPOT_LAG_MAX_ENTRIES_PER_MARKET=1       # filled entries per market
# TPB_SPOT_LAG_MAX_ATTEMPTS_PER_MARKET=3      # BUY orders per market, killed included
# TPB_SPOT_LAG_ORDER_SIZE_USDC=0              # 0 = the venue minimum (5 shares); else shares = this / price
# TPB_SPOT_LAG_MAX_ORDER_USDC=5               # worst case (limit x size) of one order
# TPB_SPOT_LAG_MAX_TOTAL_EXPOSURE_USDC=10     # open positions + working entries, worst case
# TPB_SPOT_LAG_MAX_DAILY_LOSS_USDC=10         # survives a restart (data/open_positions*.json)

# ------------------------------------------- REPRICED_MOMENTUM (strategy/repriced_momentum.py)
# EXPERIMENTAL, and the out-of-sample research found NO edge
# (docs/repriced_momentum_2026-09-24.md). A separate strategy (--strategy
# repriced_momentum) with its own settings, budget and data files; spot-lag is not
# affected by anything here. Refuses to start without TPB_REPRICED_MOM_ENABLED=1,
# and refuses micro-live/live unless TPB_REPRICED_MOM_ALLOW_REAL=1 as well.
# Paper only: ecosystem.repricedmom.config.js. The defaults below are the brief's
# FIRST configuration, not a proven one; the ecosystem file runs the rule the
# research locked on training data instead.
# TPB_REPRICED_MOM_ENABLED=0
# TPB_REPRICED_MOM_ALLOW_REAL=0
# TPB_REPRICED_MOM_MIN_PCT=0.50               # how far the token has repriced toward fair: at least ...
# TPB_REPRICED_MOM_MAX_PCT=0.90               # ... and at most (1.0 = all the way)
# TPB_REPRICED_MOM_SHOCK_WINDOW_S=5           # candidates this long after a shock (the spot-lag shock rule)
# TPB_REPRICED_MOM_MOMENTUM_HORIZON_MS=500    # the spot must still be moving our way over this lookback ...
# TPB_REPRICED_MOM_MIN_SPOT_Z=0               # ... by more than 0 and at least this many sigma (sqrt-time scaled)
# TPB_REPRICED_MOM_REQUIRE_TOKEN_AGREEMENT=1  # the token's own 500 ms move must be our way too
# TPB_REPRICED_MOM_MAX_OVERSHOOT_CENTS=1.0    # the ask at most this far past the fair value
# TPB_REPRICED_MOM_MIN_EDGE_CENTS=1.0         # expected continuation (training table) - spread - fees - slippage
# TPB_REPRICED_MOM_EDGE_GATE=1                # 0 = log the edge but do not require it
# TPB_REPRICED_MOM_LIMIT_OFFSET_CENTS=0       # FOK limit = ask + this; 0 never chases
# TPB_REPRICED_MOM_EXIT_MODE=reversal         # timer | reversal | fair | any
# TPB_REPRICED_MOM_HOLD_S=2                   # timer mode: sell this long after the fill
# TPB_REPRICED_MOM_MAX_HOLD_S=8               # event modes: never hold longer
# The strategy's OWN budget; the bot applies the tighter of it and the global limits,
# and it is a ceiling the dashboard's control file cannot lift.
# TPB_REPRICED_MOM_MAX_SIMULTANEOUS_POSITIONS=1
# TPB_REPRICED_MOM_MAX_TOTAL_EXPOSURE_USDC=5
# TPB_REPRICED_MOM_MAX_ORDER_USDC=3           # 5 shares -> asks up to 0.60
# TPB_REPRICED_MOM_MAX_DAILY_LOSS_USDC=5

# ------------------------------------------- NEXT_MARKET_TWAP (strategy/next_market_twap.py)
# RESEARCH / REPLAY ONLY. Predict the next 5-minute market ~3 s before it opens, buy the
# favoured token at the open, sell into the bid seconds later. It is not wired into the
# bot and has no real-money path (next_market_twap.REAL_MONEY is a constant False).
# Evidence: docs/next_market_twap_strategy_report.md (no out-of-sample edge).
# TPB_NEXT_MARKET_TWAP_ENABLED=false
# Any NextMarketConfig field can be overridden as TPB_NEXT_MARKET_TWAP_<FIELD>:
# TPB_NEXT_MARKET_TWAP_PREDICT_OFFSET_S=-3
# TPB_NEXT_MARKET_TWAP_ENTRY_WINDOW_S=0       # evaluate entries from the open to this many s after it
# TPB_NEXT_MARKET_TWAP_MIN_NET_EDGE=0.02      # execution-aware: exit bid - ask VWAP - adverse - both fees
# TPB_NEXT_MARKET_TWAP_MAX_SPREAD=0.03
# TPB_NEXT_MARKET_TWAP_MAX_ENTRY_PRICE=0.60
# TPB_NEXT_MARKET_TWAP_HOLD_S=3

# Real-money adapter: an ENTRY that waited longer than this between the
# decision and the POST (queue + signing) is dropped as stale.
# TPB_MAX_ENTRY_DECISION_AGE_MS=1000

# MICRO-LIVE ceilings (graduation.MicroCaps). The dashboard's control file can
# never lift a value above these while --mode micro-live runs.
# TPB_MICRO_MAX_ORDER_USD=5
# TPB_MICRO_MAX_OPEN_EXPOSURE_USD=10
# TPB_MICRO_MAX_DAILY_LOSS_USD=10
# TPB_MICRO_MAX_ORDERS_PER_HOUR=5
# TPB_MICRO_MAX_CONCURRENT_POSITIONS=1

# ---- CROSS_MARKET_ARB (strategy/cross_market_arb/) -- paper only, disabled by default --------------------
# Seven-market guaranteed-profit portfolios across BTC/ETH/SOL/XRP/DOGE/BNB/HYPE 5m UP/DOWN.
# Refuses to start without TPB_CMA_ENABLED=1; refuses shadow / micro-live / live entirely.
# pm2: ecosystem.crossmarketarb.config.js --only tpb-crossmarketarb-paper
# TPB_CMA_ENABLED=0
# TPB_CMA_MODE=paper
# TPB_CMA_MARKETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
# TPB_CMA_MINIMUM_NET_PROFIT=0.05
# TPB_CMA_MAXIMUM_BASKET_NOTIONAL=80
# TPB_CMA_MAXIMUM_MARKET_EXPOSURE=40
# TPB_CMA_MAXIMUM_QUOTE_AGE_MS=1000
# TPB_CMA_MAXIMUM_TIMESTAMP_SKEW_MS=1000
# TPB_CMA_MAXIMUM_SPREAD=0.05
# TPB_CMA_MAXIMUM_SLIPPAGE=0.01
# TPB_CMA_MAXIMUM_INCOMPLETE_EXPOSURE=40
# TPB_CMA_DAILY_LOSS_LIMIT=15
# TPB_CMA_MINIMUM_CASH_RESERVE=5

# ---- CROSS_MARKET_CORRELATION (strategy/cross_market_correlation/) -- paper only, disabled by default --------
# Pair-wise opposite-outcome trades across BTC/ETH/SOL/XRP/DOGE/BNB/HYPE 5m UP/DOWN (21 pairs × 2 directions).
# Statistical mode is OFF by default. Guaranteed label requires formal worst-case payout proof (not correlation).
# Refuses to start without TPB_CMC_ENABLED=1; refuses shadow / micro-live / live entirely.
# pm2: ecosystem.crossmarketcorr.config.js --only tpb-crossmarketcorr-paper
# TPB_CMC_ENABLED=0
# TPB_CMC_MODE=paper
# TPB_CMC_MARKETS=BTC,ETH,SOL,XRP,DOGE,BNB,HYPE
# TPB_CMC_GUARANTEED_MODE_ENABLED=1
# TPB_CMC_STATISTICAL_MODE_ENABLED=0
# TPB_CMC_MINIMUM_CONSERVATIVE_EV=0.02
# TPB_CMC_GUARANTEED_MIN_NET_PROFIT=0.01
# TPB_CMC_MIN_SAMPLE_SIZE=50
# TPB_CMC_MAX_PROBABILITY_UNCERTAINTY=0.15
# TPB_CMC_MAXIMUM_CAPITAL_PER_PAIR=40
# TPB_CMC_MAXIMUM_TOTAL_OPEN_EXPOSURE=120
# TPB_CMC_MAXIMUM_UNHEDGED_EXPOSURE=25
# TPB_CMC_MAXIMUM_DAILY_REALIZED_LOSS=15
# TPB_CMC_MINIMUM_BOOK_DEPTH=5
# TPB_CMC_MAXIMUM_QUOTE_AGE_MS=1000
# TPB_CMC_MIN_TIME_REMAINING_S=45
# TPB_CMC_UNHEDGED_POLICY=cancel_alert
# TPB_CMC_KILL_SWITCH=0
# TPB_CMC_HISTORY_PATH=

# ---- LEADER_PAIR (strategy/leader_pair/, the user's spec of 2026-10-13) -- paper only -------------------------
# The feature flag. Every parameter is TPB_LP_<FIELD> (fields: strategy/leader_pair/config.py); the pm2 app
# ecosystem.leaderpair.config.js carries the full set. Shadow / micro-live additionally need TPB_LP_ALLOW_REAL=1:
# do NOT set it before the backtest report AND days of paper fills say so (docs/leader_pair_2026-10-13.md).
TPB_LP_ENABLED=0
# TPB_LP_ALLOW_REAL=0
# TPB_LP_INIT_SHARES=10
# TPB_LP_PAIR_THRESHOLD=0.95
# TPB_LP_ACCUM_INTERVAL_S=5
# TPB_LP_ACCUM_SHARES=5
# TPB_LP_OPP_CEILING=0.50
# TPB_LP_LEADER_REVERSAL=0.50
# TPB_LP_MAX_MARKET_CAPITAL_USDC=60
# TPB_LP_MAX_TOTAL_CAPITAL_USDC=180
# TPB_LP_MAX_PURCHASES_PER_CYCLE=6
# TPB_LP_MAX_SETTLEMENT_LOSS_USDC=20
